# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizza_delivery

# Application
JWT_SECRET=your_24_hour_base64_secret_here
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:5000

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_NAME=Pizza Delivery
FROM_EMAIL=no-reply@pizzadelivery.local

# App
NEXT_PUBLIC_APP_URL=http://localhost:5173